# MONGODB_URI: The connection string for your MongoDB database.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/OmniCMS?retryWrites=true&w=majority"

# Admin CMS login credentials.
# These dictate the email and password you will use to log into the /admin dashboard.
ADMIN_EMAIL="admin@omnicms.com"
ADMIN_PASSWORD="password123"

# JWT Secret for encrypting admin authentication sessions.
# Generate a long, random string for production use.
JWT_SECRET="replace-with-a-long-random-secret"

# (Optional) GEMINI_API_KEY: Required if expanding the platform with Gemini AI features (e.g., auto-article generation).
# AI Studio automatically injects this at runtime if configured in the Secrets panel.
# GEMINI_API_KEY="MY_GEMINI_API_KEY"

