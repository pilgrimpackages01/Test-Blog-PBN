{
  "name": "omnicms-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"cd backend && PORT=3001 npx tsx server.ts\" \"cd frontend && npx vite --port 3000 --host 0.0.0.0\"",
    "build": "npm install --include=dev && cd backend && npm run build && cd ../frontend && npm run build",
    "start": "concurrently \"cd backend && PORT=3001 npm start\" \"cd frontend && npx vite preview --port 3000 --host 0.0.0.0\"",
    "preview": "npm start",
    "clean": "rm -rf frontend/dist backend/dist",
    "lint": "cd frontend && npx tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mongoose": "^8.0.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "mongodb-memory-server": "^11.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "esbuild": "^0.25.0",
    "mongodb-memory-server": "^11.2.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
